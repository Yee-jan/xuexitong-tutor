# 统一换行：源码用 LF，Windows 批处理保持 CRLF
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.ico   binary
*.zip   binary
*.db    binary
